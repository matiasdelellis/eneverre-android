<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API 30 and below (referenced by android:fullBackupContent).

   The app stores nothing in the backup worth restoring: the session lives in an
   EncryptedSharedPreferences file whose master key is in the Android Keystore
   and never leaves the device, so a restored copy cannot be decrypted. Exclude
   it instead of uploading encrypted tokens to the cloud just to discard them on
   restore — the app simply asks for the password again.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="EneverreSecureStore.xml" />
</full-backup-content>
