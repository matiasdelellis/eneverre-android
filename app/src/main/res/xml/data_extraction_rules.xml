<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API 31+ (referenced by android:dataExtractionRules).

   The secure session store is excluded from cloud backup and from device
   transfer: its master key lives in the device's Keystore, so the copied file
   would be undecryptable anyway. Everything else (non-sensitive app
   preferences such as the mosaic view mode) may be restored.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="EneverreSecureStore.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="EneverreSecureStore.xml" />
    </device-transfer>
</data-extraction-rules>
