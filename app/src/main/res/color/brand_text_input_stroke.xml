<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined text field: brand blue when focused, the theme outline otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/brand_primary" />
    <item android:color="?attr/colorOutline" />
</selector>
