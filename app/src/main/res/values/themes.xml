<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Eneverre" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <!-- Brand palette from the logo, instead of the Material 3 baseline purple. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_container</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Eneverre" parent="Base.Theme.Eneverre" />

    <!-- Branded toolbar title, used on the main screen where the title is the app name. -->
    <style name="TextAppearance.Eneverre.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <!-- Forces a fully circular FAB (Material 3 FABs are rounded squares by default). -->
    <style name="ShapeAppearanceOverlay.Eneverre.Fab.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>